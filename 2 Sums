//Python

class Solution(object):
    def twoSum(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """
        arr=[]
        for i in range(len(nums)-1):
            for j in range(i+1,len(nums)):
                if nums[i]+nums[j]==target:
                    arr=[i,j]
        return arr

//JAva
class Solution {
    public int[] twoSum(int[] nums, int target) {
        int n = nums.length;

        for (int i=0; i<n-1;i++){
            for (int j= i+1; j<n;j++){
                if(nums[i]+nums[j]==target){
                    return new int[]{i,j};
                }
            }
        }
        return new int[]{};
    }
}
